{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gregorian-09/poolsim/schemas/batch.schema.json",
  "title": "Poolsim batch simulation config",
  "oneOf": [
    {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "poolsim-config.schema.json" }
    },
    {
      "type": "object",
      "additionalProperties": true,
      "required": ["requests"],
      "properties": {
        "requests": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "poolsim-config.schema.json" }
        }
      }
    }
  ]
}
