{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gregorian-09/poolsim/schemas/budget.schema.json",
  "title": "Poolsim database budget plan config",
  "type": "object",
  "additionalProperties": true,
  "required": ["max_connections", "reserved_connections", "safety_margin_connections", "services"],
  "properties": {
    "max_connections": { "type": "integer", "minimum": 1 },
    "reserved_connections": { "type": "integer", "minimum": 0 },
    "safety_margin_connections": { "type": "integer", "minimum": 0 },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "replicas", "min_pool_size", "recommended_pool_size"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "replicas": { "type": "integer", "minimum": 1 },
          "current_pool_size": { "type": ["integer", "null"], "minimum": 0 },
          "min_pool_size": { "type": "integer", "minimum": 0 },
          "max_pool_size": { "type": ["integer", "null"], "minimum": 1 },
          "recommended_pool_size": { "type": "integer", "minimum": 1 },
          "priority": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    }
  }
}
